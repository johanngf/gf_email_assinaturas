{
  "printWidth": 80,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "semi": false,
  "endOfLine": "lf",
  "bracketSameLine": true,
  "plugins": ["prettier-plugin-css-order"],
  "cssDeclarationSorterOrder": "alphabetical",
  "cssDeclarationSorterKeepOverrides": true,
  "embeddedLanguageFormatting": "off",
  "htmlWhitespaceSensitivity": "ignore"
}
